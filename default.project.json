{
	"globIgnorePaths": [
		"**/_drafts/**"
	],
	"name": "car_wash_game",
	"tree": {
		"$className": "DataModel",
		"Lighting": {},
		"ReplicatedFirst": {},
		"ReplicatedStorage": {
			"Packages": {
				"$path": "Packages"
			}
		},
		"RobloxPluginGuiService": {},
		"ServerScriptService": {
			"server": {
				"$className": "Folder",
				"$ignoreUnknownInstances": false,
				"Server": {
					"$path": {
						"optional": "src/(startup)/Server.server.luau"
					}
				},
				"core": {
					"$className": "Folder",
					"$ignoreUnknownInstances": false,
					"PlayerState": {
						"$path": {
							"optional": "src/core/PlayerStateServer.luau"
						}
					}
				},
				"features": {
					"$ignoreUnknownInstances": false,
					"$path": {
						"optional": "src/features"
					}
				}
			}
		},
		"ServerStorage": {},
		"SoundService": {},
		"StarterGui": {},
		"StarterPack": {},
		"StarterPlayer": {
			"StarterCharacterScripts": {},
			"StarterPlayerScripts": {
				"client": {
					"$className": "Folder",
					"$ignoreUnknownInstances": false,
					"Client": {
						"$path": {
							"optional": "src/(startup)/Client.client.luau"
						}
					},
					"core": {
						"$className": "Folder",
						"$ignoreUnknownInstances": false,
						"PlayerState": {
							"$path": {
								"optional": "src/core/PlayerStateClient.luau"
							}
						}
					}
				}
			}
		},
		"Workspace": {}
