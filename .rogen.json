{
	"source": ["src"],
	"casing": "camelCase",
	"verbatim": false,
	"unwrap": false,
	"globIgnorePaths": ["**/_drafts/**"],
	"luau": {
		"output": "default.project.json",
		"build": "src"
	},
	"project": {
		"name": "car_wash_game",
		"tree": {
			"$className": "DataModel",
			"ReplicatedStorage": {
				"Packages": {
					"$path": "Packages"
				}
			}
		}
	}
}